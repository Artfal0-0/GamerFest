# Plantilla de produccion para cPanel. Copiala en el servidor como .env,
# completa todos los valores pendientes. El .env real es privado: nunca lo subas a Git.
APP_NAME="GamerFest"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.COM

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_EC
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# En cPanel, crea estos datos desde MySQL Database Wizard.
# El nombre de base de datos y usuario suelen incluir el prefijo de cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_gamerfest
DB_USERNAME=CPANELUSER_gamerfest
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# Usa los datos SMTP exactos que proporcione tu hosting o proveedor de correo.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.TU-DOMINIO.COM
MAIL_PORT=587
MAIL_USERNAME=correo@TU-DOMINIO.COM
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=correo@TU-DOMINIO.COM
MAIL_FROM_NAME="${APP_NAME}"

# VITE_BILLING_* se configura localmente en .env.production antes de `npm run build`;
# se incrusta en JavaScript público y no se lee desde este .env del servidor.
